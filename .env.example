# ---------------------------------------------------------------------------
# Intra Platform — environment template. Copy to .env and fill in real values.
# Real .env files are gitignored and must never be committed.
# ---------------------------------------------------------------------------

# === Postgres (droplet container) ===
POSTGRES_USER=intra
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=intra
# Full connection string used by the API (Drizzle / node-postgres).
DATABASE_URL=postgres://intra:change-me-strong@postgres:5432/intra
# One-shot cutover import (Phase 3): Supabase direct Postgres connection string.
# SOURCE_DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or REST import via service role (server-side only — never in web env):
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# === Redis ===
REDIS_URL=redis://redis:6379

# === API (NestJS) ===
API_PORT=8000
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000
# Secret used to sign session cookies. Generate a long random value.
SESSION_SECRET=change-me-to-a-64-char-random-string
# Cookie flags. Set SESSION_COOKIE_SECURE=true behind HTTPS (production).
SESSION_COOKIE_NAME=intra_session
SESSION_COOKIE_SECURE=false
# Session lifetime in seconds (default 12h).
SESSION_TTL_SECONDS=43200
# Bootstrap the first ops admin on empty DB (invite-only afterwards).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-admin
BOOTSTRAP_ADMIN_NAME=Ops Admin

# === Web (build-time; public only — never DB creds) ===
# Base URL the browser uses to reach the API.
# Local dev (separate ports): http://localhost:8000
# Docker/prod (same-origin behind Traefik): leave empty so the browser calls /api
VITE_API_URL=http://localhost:8000

# === Docker / Traefik ===
# Public hostname Traefik routes to (web + /api share this host).
APP_HOST=ops-test.example.com
