# ---------------------------------------------------------------------------
# Intra Platform — environment template.
#
# LOCAL DEV (defaults below): copy to .env and run dev\runservers.bat
# (Windows) — it will create .env from this file automatically on first run
# if one doesn't exist yet.
#
# STAGING / PRODUCTION: override POSTGRES_*, SESSION_*, BOOTSTRAP_ADMIN_*,
# and APP_HOST with real, strong values before running `docker compose up`
# with the root docker-compose.yml. Never commit a real .env — it is
# gitignored.
# ---------------------------------------------------------------------------

# === Postgres ===
# Local dev: matches docker-compose.dev.yml (Postgres published on host port 5434).
# Staging/prod: docker-compose.yml connects the api container to `postgres:5432`
# directly, so these three vars are the only ones that matter there.
POSTGRES_USER=intra
POSTGRES_PASSWORD=intra-dev-password
POSTGRES_DB=intra
# Full connection string used by the API (Drizzle / node-postgres).
# Local dev: host-published port from docker-compose.dev.yml (127.0.0.1:5434).
DATABASE_URL=postgres://intra:intra-dev-password@127.0.0.1:5434/intra
# One-shot cutover import (Phase 3): Supabase direct Postgres connection string.
# SOURCE_DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or REST import via service role (server-side only — never in web env):
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Safe local dev (centres only — preserves local users):
#   npm run db:import:centres-local -- --dry-run   # read-only source counts
#   npm run db:import:centres-local                  # import into local Postgres

# === Redis ===
# Local dev: host-published port from docker-compose.dev.yml (127.0.0.1:6380).
REDIS_URL=redis://127.0.0.1:6380

# === API (NestJS) ===
API_PORT=8000
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS.
# Covers the web dev server (Vite/TanStack, usually :8080, sometimes :3000)
# on both localhost and 127.0.0.1.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
# Secret used to sign session cookies. Generate a long random value for
# anything beyond local dev.
SESSION_SECRET=local-dev-secret-change-me-please-thanks
# Cookie flags. Set SESSION_COOKIE_SECURE=true behind HTTPS (staging/production).
SESSION_COOKIE_NAME=intra_session
SESSION_COOKIE_SECURE=false
# Session lifetime in seconds (default 12h).
SESSION_TTL_SECONDS=43200
# Bootstrap the first ops admin on empty DB (invite-only afterwards).
# Password must be 12+ characters with at least one letter and one number.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe12345
BOOTSTRAP_ADMIN_NAME=Ops Admin

# === Web (build-time; public only — never DB creds) ===
# Base URL the browser uses to reach the API.
# Local dev (separate ports): http://localhost:8000
# Docker/staging/prod (same-origin behind Traefik): leave empty so the browser calls /api
VITE_API_URL=http://localhost:8000

# === Docker / Traefik (staging/production only — unused for local dev) ===
# Public hostname Traefik routes to (web + /api share this host).
APP_HOST=ops-test.example.com
