# Root-context Docker builds — keep context small while allowing API image build.
.git
**/.git
**/node_modules
**/.output
**/dist
**/.env
**/.env.*
!**/.env.example
**/coverage
**/*.log
apps/api/dist
.cursor
dev
supabase
# Web build only needs apps/api/package.json; API build re-includes required paths below.
apps/api/*
!apps/api/package.json
!apps/api/nest-cli.json
!apps/api/tsconfig.json
!apps/api/tsconfig.build.json
!apps/api/src
!apps/api/drizzle
