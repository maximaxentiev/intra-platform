{
  "name": "intra-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Intra Platform — childcare staffing ops portal (monorepo: web + api).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @intra/web",
    "dev:api": "npm run start:dev --workspace @intra/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @intra/web",
    "build:api": "npm run build --workspace @intra/api",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @intra/api",
    "db:migrate": "npm run db:migrate --workspace @intra/api",
    "db:import": "npm run db:import --workspace @intra/api",
    "db:import:api": "npm run db:import:api --workspace @intra/api"
  },
  "engines": {
    "node": ">=22"
  }
}
